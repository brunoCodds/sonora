+  ///   depende de qual client foi usado — o próximo item da lista veria
+  ///   exatamente o mesmo bloqueio, então continuar a cadeia só geraria
+  ///   requisições extras sem chance real de sucesso. Por isso paramos
+  ///   na hora e ativamos um cooldown local (ver [_rateLimitCooldown]).
+  /// - qualquer outra exceção (ex.: vídeo sem os streams que aquele
+  ///   client específico consegue ver): aí sim vale tentar o próximo
+  ///   client da lista antes de desistir.
+  Future<StreamManifest> _bestAudioStreamInfoViaClients(String videoId) async {
+    _ensureNotInRateLimitCooldown();
+
+    Object? lastError;
+    StackTrace? lastStack;
+
+    for (final client in _clientFallbackOrder) {
+      try {
+        return await _yt.videos.streams.getManifest(
+          videoId,
+          ytClients: [client],
+        );
+      } on RequestLimitExceededException catch (e) {
+        _rateLimitedUntil = DateTime.now().add(_rateLimitCooldown);
+        // ignore: avoid_print
+        print(
+          'Sonora [YouTube stream]: bloqueio de tráfego do YouTube ao '
+          'tentar o client "${_clientName(client)}" para $videoId — '
+          'parando a cadeia de fallback (ver comentário de '
+          '_bestAudioStreamInfoViaClients). $e',
+        );
+        rethrow;
+      } catch (e, s) {
+        // ignore: avoid_print
+        print(
+          'Sonora [YouTube stream]: client "${_clientName(client)}" '
+          'falhou para $videoId, tentando o próximo. $e',
+        );
+        lastError = e;
+        lastStack = s;
+      }
+    }
+
+    if (lastError is Error && lastStack != null) {
+      Error.throwWithStackTrace(lastError, lastStack);
+    }
