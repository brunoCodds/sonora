+/// Liga o log verboso da própria lib `youtube_explode_dart` (nível
+/// `FINER`, exatamente como documentado no README dela). Isso mostra,
+/// linha a linha, qual request está sendo feito, para qual client
+/// (`androidSdkless`, `ios`, `tv`, `safari`...) e onde exatamente uma
+/// eventual rejeição do YouTube acontece — muito mais preciso que
+/// ficar adivinhando pelo tipo da exceção.
+///
+/// Use só temporariamente, para investigar um problema real (ex.: o
+/// `RequestLimitExceededException` sendo investigado nesta tarefa):
+/// chame isso uma única vez, bem no início do `main()`, antes de tocar
+/// ou baixar qualquer coisa. **Nunca deixe isso ligado em build
+/// publicado, nem cole a saída em lugar público (ex.: issue do GitHub,
+/// fórum) sem revisar antes** — pode conter cookies/tokens de sessão.
+void enableYoutubeVerboseLoggingForDebugging() {
+  Logger.root.level = Level.FINER;
+  Logger.root.onRecord.listen((record) {
+    // ignore: avoid_print
+    print(record);
+    if (record.error != null) {
+      // ignore: avoid_print
+      print(record.error);
+      // ignore: avoid_print
+      print(record.stackTrace);
+    }
+  });
+}
